# ============================================================
#  图寻助手 .env 配置模板 —— 复制为 .env 后按需填写
#  (.env 已被 .gitignore 忽略，不会被上传)
# ============================================================

# ---------- AI 后端（二选一，同时配置时国内直连接口优先） ----------

# 方案 A：国内直连的 OpenAI 兼容接口（推荐）
#   智谱开放平台 https://open.bigmodel.cn/  （glm-4v-flash 免费；多图用 glm-4.5v）
#   阿里百炼     https://dashscope.aliyuncs.com/compatible-mode/v1  （qwen-vl-max 等）
#   SiliconFlow  https://api.siliconflow.cn/v1
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=
OPENAI_MODEL=glm-4.5v

# 方案 B：Google Gemini（国内通常需要配置 PROXY_URL）
#   在 https://aistudio.google.com/app/apikey 免费获取
API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 强制指定后端（可选）: gemini 或 openai
#AI_PROVIDER=auto

# ---------- 图寻 Cookie（访问图寻 API 时必需） ----------
# 推荐写法：浏览器插件（Cookie-Editor 等）导出的 JSON 文件，直接填文件路径
TUXUN_COOKIE=cookies.json
# 也支持直接粘贴 fun_ticket 值或完整 Cookie 头：
# TUXUN_COOKIE=fun_ticket=xxxx
# TUXUN_COOKIE=_t_cfg=xxx; _tc=xxx; fun_ticket=xxx; SESSION=xxx

# ---------- GeoGuessr（实验性） ----------
# 浏览器登录 geoguessr.com 后导出的完整 Cookie（JSON 文件路径或完整 Cookie 头）
# GEOGUESSR_COOKIE=

# ---------- 高德 Key（可选覆盖） ----------
# 程序已内置默认高德 Key（国内地址反查开箱即用）。若配额不足，替换为你自己的：
# 申请地址 https://lbs.amap.com/ （Web服务 Key）
#AMAP_KEY=
#AMAP_JS_KEY=

# ---------- 网络 ----------
# 访问 Google 街景图片 / Gemini 使用的 HTTP 代理（图寻 API 与地图不受影响）
# Clash: http://127.0.0.1:7890    v2rayN: http://127.0.0.1:10809
# 不需要时留空
PROXY_URL=

# ---------- 其他（均可不填，走默认值） ----------
#AI_TIMEOUT=120
